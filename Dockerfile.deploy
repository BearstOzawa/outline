# Temporary Hub build from this source.
ARG APP_PATH=/opt/outline

FROM node:26.3.0 AS builder

ARG APP_PATH
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG http_proxy
ARG https_proxy
WORKDIR $APP_PATH

COPY ./package.json ./yarn.lock ./.yarnrc.yml ./
COPY ./patches ./patches

RUN apt-get -o Acquire::Retries=5 update \
  && apt-get -o Acquire::Retries=5 install -y --no-install-recommends cmake python3 make g++ curl \
  && rm -rf /var/lib/apt/lists/*

ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV NODE_USE_ENV_PROXY=1

# Corepack fetches Yarn from repo.yarnpkg.com and ignores HTTP_PROXY; install the CLI directly.
RUN curl -fsSL -o /usr/local/bin/yarn "https://repo.yarnpkg.com/4.11.0/packages/yarnpkg-cli/bin/yarn.js" \
  && chmod +x /usr/local/bin/yarn \
  && yarn --version
RUN yarn install --immutable --network-timeout 1000000

COPY . .
ARG CDN_URL
RUN yarn build
RUN yarn workspaces focus --production \
  && yarn cache clean

FROM node:26.3.0-slim AS runner

LABEL org.opencontainers.image.source="https://github.com/outline/outline"

ARG APP_PATH
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG http_proxy
ARG https_proxy
WORKDIR $APP_PATH
ENV NODE_ENV=production
ENV MALLOC_ARENA_MAX=2

RUN addgroup --gid 1001 nodejs && \
    adduser --uid 1001 --ingroup nodejs nodejs && \
    mkdir -p /var/lib/outline && \
    chown -R nodejs:nodejs /var/lib/outline && \
    chown -R nodejs:nodejs $APP_PATH

COPY --from=builder --chown=nodejs:nodejs $APP_PATH/build ./build
COPY --from=builder --chown=nodejs:nodejs $APP_PATH/server ./server
COPY --from=builder --chown=nodejs:nodejs $APP_PATH/public ./public
COPY --from=builder --chown=nodejs:nodejs $APP_PATH/.sequelizerc ./.sequelizerc
COPY --from=builder --chown=nodejs:nodejs $APP_PATH/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs $APP_PATH/package.json ./package.json

RUN apt-get -o Acquire::Retries=5 update \
  && apt-get -o Acquire::Retries=5 install -y --no-install-recommends ca-certificates \
  && (apt-get -o Acquire::Retries=5 install -y --no-install-recommends wget || true) \
  && rm -rf /var/lib/apt/lists/* \
  || true

ENV FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data

RUN mkdir -p "$FILE_STORAGE_LOCAL_ROOT_DIR" && \
    chown -R nodejs:nodejs "$FILE_STORAGE_LOCAL_ROOT_DIR" && \
    chmod 1777 "$FILE_STORAGE_LOCAL_ROOT_DIR"

VOLUME /var/lib/outline/data

USER nodejs

HEALTHCHECK --interval=1m CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/_health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

EXPOSE 3000
CMD ["node", "build/server/index.js"]
